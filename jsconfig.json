{
  "compilerOptions": {
    "lib": ["es2016", "dom", "es2017", "es2020"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "checkJs": true,
    "strictNullChecks": false,
    "noImplicitAny": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "public", "scratch", "assets"]
}
