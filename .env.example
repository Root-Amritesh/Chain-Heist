# ==============================================================================
# BIT-HUNTER 2099 / CHAIN HEIST — Backend Leaderboard Configuration
# ==============================================================================
# The game runs with a built-in consensus cache out of the box (zero-config local/offline fallback).
# To connect a persistent remote MongoDB database for cross-player global consensus:

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name (defaults to 'bithunter')
MONGODB_DB_NAME=bithunter

# Note: All leaderboard queries and submissions validate schema, enforce rate limits (10/min/IP),
# and support HTTP ETag / 304 caching. No secrets are exposed to the client.
