# BIT-HUNTER 2099 — Remote Leaderboard Configuration
# Copy this file to .env.local to enable shared remote Supabase leaderboard

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==============================================================================
# SUPABASE SQL TABLE SCHEMA & ROW LEVEL SECURITY POLICIES
# Run the following SQL in your Supabase SQL Editor:
# ==============================================================================
#
# CREATE TABLE leaderboard (
#   id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
#   name TEXT NOT NULL,
#   score INTEGER NOT NULL,
#   districts INTEGER NOT NULL DEFAULT 0,
#   tokens INTEGER NOT NULL DEFAULT 0,
#   badge TEXT NOT NULL DEFAULT 'NONE',
#   verification_code TEXT NOT NULL UNIQUE,
#   created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
# );
#
# -- Enable Row Level Security (RLS)
# ALTER TABLE leaderboard ENABLE ROW LEVEL SECURITY;
#
# -- Policy 1: Allow anyone to view leaderboard entries (Public Read)
# CREATE POLICY "Allow public select" ON leaderboard
#   FOR SELECT TO anon, authenticated USING (true);
#
# -- Policy 2: Allow anyone to submit a verified score (Public Insert Only)
# CREATE POLICY "Allow public insert" ON leaderboard
#   FOR INSERT TO anon, authenticated WITH CHECK (true);
#
# -- Note: No UPDATE or DELETE policies are granted to anon/public.

